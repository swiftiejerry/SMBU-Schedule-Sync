# Copy to backend/.env and fill in. NEVER commit the real .env.
# All vars are optional except where noted; defaults are safe for local dev.

# Comma-separated list of allowed browser origins. For the production monolith
# this is just your frontend domain. REQUIRED in prod (avoids CORS `*`).
SMBU_ALLOW_ORIGINS=https://calendar.yourdomain.com

# Raw upstream dump endpoint. OFF by default — keep it off in prod.
SMBU_DEBUG_RAW_ENDPOINT=false

# Aggregate payment. Stays OFF until the business sets a price + gateway keys.
SMBU_PAYMENTS_ENABLED=false
SMBU_PAYMENT_CENTS=0

# --- transport / resilience (defaults shown) ---
SMBU_MAX_CONCURRENT_UPSTREAM=32
SMBU_PER_STUDENT_UPSTREAM_LIMIT=6
SMBU_RATE_LIMIT_PER_MINUTE_IP=30
SMBU_RATE_LIMIT_PER_MINUTE_STUDENT=10

# Login limits. Behind a docker bridge / campus NAT every student shares ONE
# source IP, so keep the IP bucket generous and let the per-username bucket
# (default 6/min) cap per-account brute force.
SMBU_LOGIN_RATE_LIMIT_PER_MINUTE_IP=60
SMBU_LOGIN_RATE_LIMIT_PER_MINUTE_USER=6

# X-Forwarded-For is trusted ONLY from these CIDRs (your nginx / LB).
# Empty = trust nobody: a direct client cannot spoof IPs past the limiter.
# Example: SMBU_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8
SMBU_TRUSTED_PROXIES=

SMBU_UPSTREAM_VERIFY_TLS=false

# Session + payload (defaults shown)
SMBU_SESSION_TTL_S=900
SMBU_MAX_ICS_EVENTS=2000
SMBU_ICS_REMINDER_MINUTES=15

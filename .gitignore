# ===== Runtime data / secrets / captured fixtures =====
# Sessions are RAM-only, but the (now-unused) payments ledger and any local
# captured academic fixtures must NEVER be open-sourced.
backend/data/
*.db
*.sqlite
*.sqlite3

# Real captured 教务报文 (PII: student id, name, course schedule).
# The mock server regenerates fixtures locally; do not ship these.
deploy/mock/raw/

# ===== _probe: 抓包/探针工作区（整目录排除）=====
# 内含真实 PII，绝不可开源：
#   raw/current_user.json   -> userId 学号 + userName 真实姓名
#   raw/raw_*.json          -> 真实课表
#   cj.txt / cj2.txt        -> 真实登录会话 Cookie (JSESSIONID / route token)
#   cas.html / out/*.png    -> 真实登录页与截图
# 压力测试结论已另存为 docs/STRESS_REPORT.md（已确认无 PII）。
_probe/
# 兜底：任何位置都不允许提交 Cookie 文件与抓取产物
*.txt.ck
_probe/**/raw/

# Secrets — .env.example is the committed template, real .env is not.
.env
.env.*
!.env.example

